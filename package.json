{
  "name": "s3sh",
  "version": "0.2.60127",
  "author": "Paul Whittemore <dev@authordesktop.com>",
  "description": "A shell-like CLI for testing an AWS S3-compatible store.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "bun main.js",
    "build:linux": "bun build --compile --target=bun-linux-x64 main.js --outfile s3sh",
    "build:win": "bun build --compile --target=bun-windows-x64 main.js --outfile s3sh.exe",
    "build:mac-x64": "bun build --compile --target=bun-darwin-x64 main.js --outfile s3sh-macos-x64",
    "build:mac-arm64": "bun build --compile --target=bun-darwin-arm64 main.js --outfile s3sh-macos-arm64"
  },
  "engines": {
    "bun": ">= 1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/credential-provider-ini": "^3.972.2",
    "arg": "^5.0.2",
    "chalk": "^4.1.2"
  }
}
